# ──────────────────────────────────────────────────────────
# Vehicle Maintenance Scheduler — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the populated .env file to version control.

# Port the Express server will listen on
PORT=3000

# ── Evaluation Service Auth Credentials ────────────────────
# These are obtained during registration with the test server.
# Log API: http://4.224.186.213/evaluation-service/auth

LOG_EMAIL=your.email@college.edu
LOG_NAME=Your Full Name
LOG_ROLL_NO=yourRollNo
LOG_ACCESS_CODE=yourAccessCode
LOG_CLIENT_ID=your-client-id-uuid
LOG_CLIENT_SECRET=yourClientSecret
